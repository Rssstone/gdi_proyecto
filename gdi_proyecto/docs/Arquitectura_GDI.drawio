<mxfile host="app.diagrams.net"><diagram id="gdi" name="Arquitectura GDI"><mxGraphModel dx="2200" dy="830" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="830" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;GDI · Gestión Dental Integral&lt;/b&gt; — Cómo se comunican las 3 capas" style="text;html=1;fontSize=26;fontColor=#12336b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="2120" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Línea gruesa = petición · línea punteada = respuesta · las tarjetas resumen los parámetros de cada conexión" style="text;html=1;fontSize=14;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="2120" height="24" as="geometry"/></mxCell><mxCell id="c4" value="CAPA 1 · PRESENTACIÓN" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#ffffff;strokeColor=none;fillColor=#5f6b7a;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="420" height="46" as="geometry"/></mxCell><mxCell id="c5" value="CAPA 2 · NEGOCIO" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#ffffff;strokeColor=none;fillColor=#2463b8;" vertex="1" parent="1"><mxGeometry x="880" y="96" width="420" height="46" as="geometry"/></mxCell><mxCell id="c6" value="CAPA 3 · DATOS" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontColor=#ffffff;strokeColor=none;fillColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1740" y="96" width="420" height="46" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Laptop del equipo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#555&quot;&gt;Navegador · Live Server&lt;/span&gt;" style="rounded=1;arcSize=2;html=1;whiteS