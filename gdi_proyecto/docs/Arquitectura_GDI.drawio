1"><mxGeometry x="2060" y="164" width="54" height="54" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Tablas principales&lt;/b&gt;&lt;br&gt;• usuarios · pacientes&lt;br&gt;• citas&lt;br&gt;• expedientes · odontograma&lt;br&gt;• fichas_tecnicas · estudios" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#333333;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1770" y="300" width="360" height="250" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;MySQL 8&lt;/b&gt;&lt;br&gt;base de datos &lt;b&gt;gdi_db&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1770" y="600" width="360" height="110" as="geometry"/></mxCell><mxCell id="c27" value="petición HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;strokeWidth=3;fontSize=13;fontStyle=1;strokeColor=#2463b8;fontColor=#2463b8;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c12" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="respuesta JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;strokeWidth=2;dashed=1;fontSize=13;strokeColor=#2463b8;fontColor=#2463b8;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="c17" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="&lt;span style=&quot;font-size:16px;color:#2463b8&quot;&gt;&lt;b&gt;① Presentación → Negocio&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;HTTP + JSON · puerto 8080&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Dirección:&lt;/b&gt; GDI_API_URL&lt;br&gt;http://68.211.137.169:8080/api&lt;br&gt;&lt;br&gt;&lt;b&gt;Envía:&lt;/b&gt; método + ruta + datos&lt;br&gt;Ej.: &lt;b&gt;POST /api/citas&lt;/b&gt;&lt;br&gt;{ pacienteId, odontologoId, fecha, hora, duracionMinutos, motivo, urgente }&lt;br&gt;&lt;br&gt;&lt;b&gt;Recibe:&lt;/b&gt; JSON con el resultado o un error (400, 404, 409, 422) con su mensaje" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacing=12;strokeColor=#2463b8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="440" width="380" height="300" as="geometry"/></mxCell><mxCell id="c30" value="consulta SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;strokeWidth=3;fontSize=13;fontStyle=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c19" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="filas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#4d4d4d;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;strokeWidth=2;dashed=1;fontSize=13;strokeColor=#b85450;fontColor=#b85450;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="c26" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="&lt;span style=&quot;font-size:16px;color:#b85450&quot;&gt;&lt;b&gt;② Negocio → Datos&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;JDBC + SQL · puerto 3306 (cifrado)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Dirección:&lt;/b&gt;&lt;br&gt;jdbc:mysql://68.211.113.177:3306/gdi_db&lt;br&gt;&lt;br&gt;&lt;b&gt;Credenciales:&lt;/b&gt; usuario &lt;b&gt;gdi&lt;/b&gt; y su contraseña (guardadas en la VM, no en el código)&lt;br&gt;&lt;br&gt;&lt;b&gt;Envía:&lt;/b&gt; SQL que genera JPA&lt;br&gt;Ej.: SELECT * FROM citas WHERE fecha = ? AND odontologo_id = ?&lt;br&gt;&lt;br&gt;&lt;b&gt;Recibe:&lt;/b&gt; filas → objetos Java (Cita, Paciente…)" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacing=12;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1340" y="230" width="380" height="330" as="geometry"/></mxCell><mxCell id="c33" value="El detalle de cada método y parámetro está en &lt;b&gt;Arquitectura_GDI_detallado&lt;/b&gt; (para cuando el profesor revise el código)." style="text;html=1;fontSize=13;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="2120" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>